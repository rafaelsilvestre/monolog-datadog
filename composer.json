{
    "name": "rafaelsilvestre/monolog-datadog",
    "description": "Monolog Handler for Datadog Logs (HTTP intake, Logs API v2)",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Gusp",
            "email": "contact@gusp.io"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "monolog/monolog": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "MonologDatadog\\": "src/Monolog"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MonologDatadog\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs"
    }
}
